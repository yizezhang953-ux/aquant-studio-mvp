APP_NAME=AQuant Studio API
APP_ENV=local
API_V1_PREFIX=/api/v1
LIVE_TRADING_ENABLED=false

# Local default:
DATABASE_URL=sqlite:///./aquant_web_app.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://aquant:aquant_password@localhost:5432/aquant_studio

# Comma-separated. Must include the deployed frontend origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Accounts. Administrators write shared market data. Grant the role on the server with
#   python -m app.tasks.database_maintenance make-admin you@example.com
# FIRST_USER_IS_ADMIN defaults to true only when APP_ENV=local.
# FIRST_USER_IS_ADMIN=
ALLOW_REGISTRATION=true
PASSWORD_HASH_ITERATIONS=600000

# Startup: apply Alembic migrations, seed templates + bundled sample data on an empty database.
RUN_MIGRATIONS_ON_STARTUP=true
SEED_ON_STARTUP=true

# Imports
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_BARS=50000

# Real market data (Tencent / HKEX / Frankfurter). Set false on hosts without internet access.
MARKET_DATA_NETWORK_ENABLED=true

# Put backups on persistent storage (a mounted volume in containers).
BACKUP_DIR=runtime/backups
