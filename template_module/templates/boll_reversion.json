{
  "schema_version": "1.0",
  "strategy_id": "template_boll_reversion",
  "name": "布林带下轨回归策略",
  "description": "收盘价跌破布林带下轨（20 日、2 倍标准差）买入，回到中轨上方卖出，赌价格回到均值。",
  "market": "a_share",
  "universe": {
    "type": "single",
    "symbols": [
      "000001.SZ"
    ]
  },
  "data": {
    "frequency": "1d",
    "adjustment": "forward",
    "start_date": "2016-01-01",
    "end_date": "2025-12-31"
  },
  "entry": {
    "logic": "all",
    "conditions": [
      {
        "left": {
          "type": "price",
          "field": "close"
        },
        "operator": "lt",
        "right": {
          "type": "indicator",
          "name": "BOLL",
          "params": {
            "period": 20,
            "std": 2,
            "output": "lower",
            "field": "close"
          }
        }
      }
    ]
  },
  "exit": {
    "logic": "any",
    "conditions": [
      {
        "left": {
          "type": "price",
          "field": "close"
        },
        "operator": "gt",
        "right": {
          "type": "indicator",
          "name": "BOLL",
          "params": {
            "period": 20,
            "std": 2,
            "output": "middle",
            "field": "close"
          }
        }
      }
    ]
  },
  "position": {
    "initial_cash": 1000000,
    "order_size_type": "cash_pct",
    "order_size_value": 0.9,
    "max_position_pct": 1.0
  },
  "execution": {
    "entry_price": "next_open",
    "exit_price": "next_open",
    "commission_rate": 0.00025,
    "slippage_rate": 0.0005
  },
  "risk": {
    "stop_loss_pct": 0.08,
    "take_profit_pct": null,
    "max_drawdown_pct": null,
    "max_holding_bars": 20
